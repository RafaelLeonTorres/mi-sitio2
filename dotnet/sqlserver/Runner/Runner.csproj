<Project Sdk="Microsoft.NET.Sdk">
  <!--
    El ejecutor de T-SQL del curso de SQL Server: corre scripts en un SQL Server de verdad, en una base
    temporal con intercalación explícita, y devuelve lo que SSMS mostraría (los resultados de cada lote
    y sus mensajes: PRINT y errores con número, gravedad, estado y línea). Lo usan
    scripts/sqlserver-capture.mjs (las salidas capturadas) y scripts/sqlserver-lessons.test.ts (las
    soluciones y los ejemplos de las lecciones). Usa Microsoft.Data.SqlClient, el cliente de SSMS y de
    Azure Data Studio, y no un controlador de Node: con la autenticación de Windows entra al SQL Server
    local, y con usuario y contraseña, a uno en un contenedor. Se corre desde Node (scripts/sqlserver-client.mjs)
    con `dotnet run`, pasándole el archivo del pedido y el de la respuesta (los argumentos in y out).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SqlServerRunner</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <!-- SqlClient 6.1.7 trae System.Security.Cryptography.Pkcs 9.0.11, con avisos de seguridad conocidos
         (GHSA-846f y GHSA-2fmv); una referencia directa a una versión corregida la reemplaza. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
</Project>
