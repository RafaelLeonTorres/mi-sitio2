{
  // Terminal > Ejecutar tarea… (o Ctrl+Shift+B para compilar los LaTeX)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sitio: levantar en http://localhost:4000/mi-sitio2/",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Laboratorio: compilar al guardar",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Sitio y laboratorio",
      "dependsOn": [
        "Sitio: levantar en http://localhost:4000/mi-sitio2/",
        "Laboratorio: compilar al guardar"
      ],
      "problemMatcher": []
    },
    {
      "label": "LaTeX: compilar CV y cartas",
      "type": "shell",
      "command": "bash latex/compilar.sh",
      "windows": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File latex/compilar.ps1"
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
