{
  // Herramientas que corren en Node: los scripts (JavaScript revisado con JSDoc), sus pruebas y la
  // configuración de Vitest. La resolución es la de un bundler, como en labs/, porque algunas
  // pruebas (las soluciones de los retos) importan el código del laboratorio.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": ["scripts", "vitest.config.ts"]
}
