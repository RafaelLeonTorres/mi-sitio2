{
  "name": "mi-sitio2-laboratorio",
  "private": true,
  "description": "Demos interactivas del sitio: TypeScript con esbuild y Vitest.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-labs.mjs --watch",
    "build": "node scripts/build-labs.mjs",
    "pages": "node scripts/challenge-pages.mjs",
    "csharp": "node scripts/csharp-engine.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electric-sql/pglite": "^0.5.17",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
